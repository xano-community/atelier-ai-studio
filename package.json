{
  "name": "ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run xano:routes && vite",
    "build": "npm run xano:routes && tsc --noEmit && tsc -p xano/lambdas && vite build",
    "preview": "vite preview",
    "typecheck": "npm run xano:routes && tsc --noEmit && tsc -p xano/lambdas",
    "xano:routes": "xanosdk routes ./xano/index.ts --emit xano/routes.gen.ts",
    "xano:export": "npm run xano:routes && tsc --noEmit && tsc -p xano/lambdas && xanosdk export ./xano/index.ts --out workspace.json",
    "xano:deploy": "npm run xano:routes && tsc --noEmit && tsc -p xano/lambdas && node scripts/deploy.mjs --allow-empty-env=MCP_OAUTH_LOGIN_URL --allow-empty-env=ANTHROPIC_API_KEY --allow-empty-env=GEMINI_API_KEY --allow-empty-env=SETUP_TOKEN ./xano/index.ts --keep-data",
    "xano:deploy:ephemeral": "npm run build && node scripts/deploy.mjs --allow-empty-env=MCP_OAUTH_LOGIN_URL --allow-empty-env=ANTHROPIC_API_KEY --allow-empty-env=GEMINI_API_KEY --allow-empty-env=SETUP_TOKEN ./xano/index.ts --ephemeral --static ./frontend/dist",
    "xano:deploy:production": "npm run build && node scripts/deploy.mjs --allow-empty-env=MCP_OAUTH_LOGIN_URL --allow-empty-env=ANTHROPIC_API_KEY --allow-empty-env=GEMINI_API_KEY ./xano/production.ts --static ./frontend/dist",
    "xano:deploy:frontend": "npm run build && xanosdk publish ./frontend/dist",
    "xano:check": "xanosdk routes ./xano/index.ts --emit xano/routes.gen.ts --strict && tsc --noEmit && tsc -p xano/lambdas && xanosdk export ./xano/index.ts --check --strict",
    "xano:test": "xanosdk test run-all",
    "test": "vitest run",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "qa:playground": "node frontend/scripts/playground-check.mjs",
    "qa:library": "node frontend/scripts/library-check.mjs",
    "qa:recipes": "node frontend/scripts/recipes-check.mjs",
    "qa:assistant": "node frontend/scripts/assistant-check.mjs",
    "qa:first-run": "node frontend/scripts/first-run-check.mjs",
    "qa:knowledge": "node frontend/scripts/knowledge-check.mjs",
    "qa:spend": "node frontend/scripts/spend-check.mjs",
    "qa:steps": "node frontend/scripts/steps-check.mjs",
    "qa:ai-calls": "node frontend/scripts/ai-calls-check.mjs",
    "seed:vectors": "node scripts/seed-vectors.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "*",
    "@tanstack/react-virtual": "^3.14.26",
    "@xano-sdk/agents": "^0.2.2",
    "@xano-sdk/chatbot": "^1.2.1",
    "@xano-sdk/mcp-oauth": "^1.0.2",
    "@xano-sdk/rbac": "^0.2.0",
    "@xano/sdk": "1.0.22",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.475.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  },
  "xanosdk": {
    "@xano/sdk": {
      "engine": "v0.2.16"
    }
  }
}
